---
import SocialIcons from "@/components/SocialIcons";
import menu from "@/config/menu.json";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border-color dark:border-border-color-dark">
  <div class="mx-auto max-w-5xl px-5 py-12 md:px-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="text-lg font-black tracking-tight text-text-heading dark:text-text-heading-dark">
          Coderystack
        </a>
        <p class="mt-3 max-w-xs text-sm leading-6 text-text-body dark:text-text-body-dark">
          Practical notes on mobile engineering, backend systems, and working well with AI tools.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">
          Pages
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          {
            Object.values(menu)
              .filter(({ visible }) => !!visible)
              .map(({ url, translationKey }) => (
                <li>
                  <a
                    href={url}
                    class="text-text-body capitalize transition-colors hover:text-primary-color dark:text-text-body-dark"
                  >
                    {translationKey.replace("nav.", "")}
                  </a>
                </li>
              ))
          }
        </ul>
      </nav>

      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">
          Elsewhere
        </p>
        <SocialIcons className="mt-4" />
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border-color pt-6 dark:border-border-color-dark sm:flex-row">
      <p class="font-mono text-xs text-text-meta dark:text-text-meta-dark">© CoderyStack {year}</p>
      <p class="font-mono text-xs text-text-meta dark:text-text-meta-dark">Built with Astro</p>
    </div>
  </div>
</footer>
