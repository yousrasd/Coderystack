---
import Base from "@/layouts/Base.astro";
import SocialIcons from "@/components/SocialIcons";

export const prerender = true;

---

<Base>
	<section class="max-w-5xl mx-auto px-5 md:px-12 py-12 md:py-20">
		<div class="grid gap-10 border-b border-border-color pb-12 dark:border-border-color-dark lg:grid-cols-[1fr_320px]">
			<div>
				<p class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">About Coderystack</p>
				<h1 class="max-w-3xl text-4xl md:text-6xl font-black leading-[1.02] text-text-heading dark:text-text-heading-dark">
					I write about the parts of software that teach you back.
				</h1>
				<p class="mt-7 max-w-2xl text-lg leading-8 text-text-body dark:text-text-body-dark">
					I'm Yousra, a mobile developer with experience across backend and frontend projects. Coderystack is my place for practical notes on Android, Kotlin, product engineering, AI-assisted coding, and the decisions that happen between the tutorial and production.
				</p>
				<SocialIcons className="mt-8" />
			</div>

			<aside class="self-start rounded-xl border border-primary-color/20 bg-primary-color-light/40 p-6 dark:border-border-color-dark dark:bg-surface-dark">
				<p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-color">Current focus</p>
				<ul class="mt-5 space-y-3 text-text-body dark:text-text-body-dark">
					<li>Android and Kotlin fundamentals</li>
					<li>Backend patterns that support mobile apps</li>
					<li>Working well with AI coding tools</li>
					<li>Clear explanations for practical engineering problems</li>
				</ul>
			</aside>
		</div>

		<div class="grid gap-5 py-12 md:grid-cols-3">
			<div class="rounded-xl border border-border-color border-t-2 border-t-primary-color bg-surface p-6 dark:border-border-color-dark dark:border-t-primary-color dark:bg-surface-dark">
				<h2 class="text-xl font-black text-text-heading dark:text-text-heading-dark">What I value</h2>
				<p class="mt-3 leading-7 text-text-body dark:text-text-body-dark">Simple systems, readable code, patient learning, and clear write-ups from real engineering work.</p>
			</div>
			<div class="rounded-xl border border-border-color border-t-2 border-t-primary-color bg-surface p-6 dark:border-border-color-dark dark:border-t-primary-color dark:bg-surface-dark">
				<h2 class="text-xl font-black text-text-heading dark:text-text-heading-dark">What I write</h2>
				<p class="mt-3 leading-7 text-text-body dark:text-text-body-dark">Tutorials, debugging stories, architecture notes, and reflections on how engineering practice changes with AI.</p>
			</div>
			<div class="rounded-xl border border-border-color border-t-2 border-t-secondary-color bg-surface p-6 dark:border-border-color-dark dark:border-t-secondary-color dark:bg-surface-dark">
				<h2 class="text-xl font-black text-text-heading dark:text-text-heading-dark">Where to find me</h2>
				<p class="mt-3 leading-7 text-text-body dark:text-text-body-dark">
					I share longer writing here, and shorter updates on social media.
				</p>
				<SocialIcons className="mt-4" />
			</div>
		</div>
		<div class="border-t border-border-color pt-12 dark:border-border-color-dark">
			<p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">Experience</p>
			<h2 class="text-3xl md:text-4xl font-black leading-tight text-text-heading dark:text-text-heading-dark">
				Eight years of shipping software.
			</h2>

			<div class="mt-10 space-y-10 border-l-2 border-primary-color-light pl-8 dark:border-border-color-dark">
				<div class="relative">
					<span class="absolute -left-[41px] top-1.5 h-4 w-4 rounded-full border-2 border-primary-color bg-bg-primary dark:bg-bg-primary-dark"></span>
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-secondary-color">Now</p>
					<h3 class="mt-2 text-xl font-black text-text-heading dark:text-text-heading-dark">
						Software Engineer <span class="text-primary-color">· Sport industry</span>
					</h3>
					<p class="mt-2 max-w-2xl leading-7 text-text-body dark:text-text-body-dark">
						Building software in the sport industry.
					</p>
				</div>

				<div class="relative">
					<span class="absolute -left-[41px] top-1.5 h-4 w-4 rounded-full border-2 border-primary-color bg-bg-primary dark:bg-bg-primary-dark"></span>
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-secondary-color">2020 — 2026</p>
					<h3 class="mt-2 text-xl font-black text-text-heading dark:text-text-heading-dark">
						Mobile Developer <span class="text-primary-color">· Lyft</span>
					</h3>
					<p class="mt-2 max-w-2xl leading-7 text-text-body dark:text-text-body-dark">
						Shipped mobile apps for bike share, used by riders in cities around the world.
					</p>
				</div>

				<div class="relative">
					<span class="absolute -left-[41px] top-1.5 h-4 w-4 rounded-full border-2 border-primary-color bg-bg-primary dark:bg-bg-primary-dark"></span>
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-secondary-color">2018 — 2020</p>
					<h3 class="mt-2 text-xl font-black text-text-heading dark:text-text-heading-dark">
						Web Developer <span class="text-primary-color">· Acquisio</span>
					</h3>
					<p class="mt-2 max-w-2xl leading-7 text-text-body dark:text-text-body-dark">
						Shipped a platform helping small and medium businesses launch campaigns on Google Ads.
					</p>
				</div>
			</div>

			<div class="mt-12 rounded-xl border border-primary-color/20 bg-primary-color-light/40 p-6 dark:border-border-color-dark dark:bg-surface-dark">
				<p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-color">On the side</p>
				<p class="mt-3 text-lg leading-8 text-text-body dark:text-text-body-dark">
					I'm building <a href="https://fisky.app" target="_blank" rel="noopener noreferrer" class="font-bold text-primary-color underline underline-offset-4 hover:text-text-heading dark:hover:text-text-heading-dark">fisky.app</a> — my own app, designed, built, and launched end to end. I write about the journey here.
				</p>
			</div>
		</div>
	</section>
</Base>
