---
// @ts-nocheck

import Base from "@/layouts/Base.astro";
import type { CollectionEntry } from "astro:content";

import config from "@/config/config.json";
import { sortByDate } from "@/utils/strings";
import Post from "@/components/Post";
import Pagination from "@/components/Pagination";
import SocialIcons from "@/components/SocialIcons";
import { getSinglePage } from "@/utils/contentParser.astro";

const posts = sortByDate(
  await getSinglePage<CollectionEntry<"posts">>("posts")
);

const paginationSize = config.settings.pagination;

const totalPages = Math.ceil(posts.length / paginationSize);

const page = Number(Astro.url.searchParams.get("page")) || 1;
const postsSliceStart = (page - 1) * paginationSize;
const postsSliceEnd = postsSliceStart + paginationSize;
const currentPosts = posts.slice(postsSliceStart, postsSliceEnd);
const latestPost = posts[0]?.data?.date
  ? new Date(posts[0].data.date).toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
    })
  : "Recently";
const categories = [
  ...new Set(posts.flatMap((post) => post.data.categories ?? [])),
].slice(0, 5);
---

<Base>
  <section class="mx-auto max-w-6xl px-5 pb-12 pt-8 md:px-12 md:pb-16 md:pt-14">
    <div class="grid gap-10 border-b border-border-color pb-14 dark:border-border-color-dark lg:grid-cols-[1fr_340px] lg:gap-14">
      <div>
        <p class="mb-6 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">
          Yousra Saidani — Mobile & Backend Engineer
        </p>

        <h1 class="max-w-3xl text-4xl font-black leading-[1.04] text-text-heading dark:text-text-heading-dark md:text-5xl lg:text-6xl">
          Notes from building software in the real world.
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-text-body dark:text-text-body-dark">
          Practical writing on Android, Kotlin, backend systems, debugging,
          and learning how to stay sharp while working with AI tools.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="#recent-writing"
            class="rounded-full bg-primary-color px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-text-heading dark:text-bg-primary-dark dark:hover:bg-text-heading-dark"
          >
            Read the notes
          </a>
          <a
            href="/about"
            class="rounded-full border border-border-color px-5 py-3 text-sm font-bold text-text-heading transition-colors hover:border-primary-color hover:text-primary-color dark:border-border-color-dark dark:text-text-heading-dark"
          >
            About me
          </a>
        </div>

        <SocialIcons className="mt-8" />
      </div>

      <aside class="grid content-start gap-4">
        <div class="rounded-xl border border-primary-color/20 bg-primary-color-light/40 p-6 dark:border-border-color-dark dark:bg-surface-dark">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-primary-color">
            What I write about
          </p>
          <p class="mt-4 text-xl font-bold leading-snug text-text-heading dark:text-text-heading-dark">
            Mobile craft, backend tradeoffs, and the thinking behind the code.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {
              categories.map((category) => (
                <a
                  href={`/category/${category}`}
                  class="rounded-full border border-border-color bg-surface px-3 py-1.5 font-mono text-xs text-text-body transition-colors hover:border-primary-color hover:text-primary-color dark:border-border-color-dark dark:bg-surface-muted-dark dark:text-text-body-dark"
                >
                  {category}
                </a>
              ))
            }
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-xl border border-border-color bg-surface p-5 dark:border-border-color-dark dark:bg-surface-dark">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-secondary-color">
              Notes
            </p>
            <p class="mt-3 text-4xl font-black text-text-heading dark:text-text-heading-dark">
              {posts.length}
            </p>
          </div>
          <div class="rounded-xl border border-border-color bg-surface p-5 dark:border-border-color-dark dark:bg-surface-dark">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-secondary-color">
              Latest
            </p>
            <p class="mt-3 text-2xl font-black text-text-heading dark:text-text-heading-dark">
              {latestPost}
            </p>
          </div>
        </div>
      </aside>
    </div>

    <div id="recent-writing" class="mt-14 scroll-mt-24 border-b border-border-color pb-8 dark:border-border-color-dark">
      <div>
        <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">
          Dispatches
        </p>
        <h2 class="text-4xl font-black leading-tight text-text-heading dark:text-text-heading-dark md:text-5xl">
          Recent writing
        </h2>
      </div>
    </div>

    <div class="pt-2">
    {
      currentPosts.map((post, index) => (
        <Post
          post={{
            id: post.id,
            slug: post.id,
            body: post.body,
            showFullPost: false,
            embededCodeLanguage: post.embededCodeLanguage,
            ...post.data,
          }}
          featured={index === 0}
          index={index + 1}
          client:idle
        />
      ))
    }
    </div>
    {
      totalPages > 1 && (
        <div class="flex flex-row justify-center py-10">
          <Pagination paginationSize={totalPages} activePage={1} />
        </div>
      )
    }
  </section>
</Base>
