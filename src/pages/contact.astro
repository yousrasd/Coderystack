---
import Base from "@/layouts/Base.astro";
import SocialIcons from "@/components/SocialIcons";
import config from "@/config/config.json";

export const prerender = true;

---

<Base>
	<section class="max-w-3xl mx-auto px-5 md:px-12 py-12 md:py-20">
		<p class="mb-5 font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">Contact</p>
		<h1 class="text-4xl md:text-6xl font-black leading-[1.02] text-text-heading dark:text-text-heading-dark">
			Let's talk about software, writing, or thoughtful product work.
		</h1>
		<p class="mt-7 text-lg leading-8 text-text-body dark:text-text-body-dark">
			The best place to reach me is LinkedIn. I’m especially happy to connect about Android, Kotlin, backend systems, developer learning, and AI-assisted engineering.
		</p>

		<div class="mt-10 flex flex-wrap gap-3">
			<a href={config.social.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full bg-primary-color px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-text-heading dark:text-bg-primary-dark dark:hover:bg-text-heading-dark">
				Message on LinkedIn
			</a>
			<a href={config.social.github} target="_blank" rel="noopener noreferrer" class="rounded-full border border-border-color px-5 py-3 text-sm font-bold text-text-heading transition-colors hover:border-primary-color hover:text-primary-color dark:border-border-color-dark dark:text-text-heading-dark">
				View GitHub
			</a>
		</div>

		<div class="mt-12 border-t border-border-color pt-8 dark:border-border-color-dark">
			<p class="font-mono text-xs font-semibold uppercase tracking-[0.22em] text-secondary-color">
				Elsewhere
			</p>
			<SocialIcons className="mt-4" />
		</div>
	</section>
</Base>
